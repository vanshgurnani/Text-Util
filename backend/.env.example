APP_ENV=development
WEB_SESSION_DAYS=7
COOKIE_SECURE=false
AUTH_RATE_LIMIT=30
MCP_RATE_LIMIT=120
METRICS_TOKEN=
MONGO_URI=mongodb://mongo:27017
MONGO_DB=noteform
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Optional legacy service-to-service API key. Per-user MCP tokens and OAuth are preferred.
MCP_API_KEY=
MCP_USER_ID=
MCP_TOKEN_SCOPES=notes:read notes:write

# Public URL used by an MCP client after Cloudflare Tunnel is configured.
MCP_PUBLIC_URL=https://mcp.example.com/mcp
